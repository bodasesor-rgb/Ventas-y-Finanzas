# Copia a .env en el servidor (Hostinger) — no subir secretos al repo
PORT=3000

# Ej: https://tudominio.kommo.com
KOMMO_BASE_URL=

# Long-lived access token de Kommo
KOMMO_ACCESS_TOKEN=

# Fase 2: URL de la app web Apps Script (debe terminar en /exec)
# En Hostinger la tienes como URL_BODASESOR_DIRECCION_SHEETS
URL_BODASESOR_DIRECCION_SHEETS=
# Alias opcional:
# APPS_SCRIPT_VENTAS_URL=
# ID_DE_IMPLEMENTACION_BODASESOR_DIRECCION no se usa en el código

# Google Analytics 4 → Metricas (Visitas)
# Property ID numérico (Admin → Property settings)
GA4_PROPERTY_ID=
# JSON completo del service account (o base64 del JSON)
GOOGLE_SERVICE_ACCOUNT_JSON=
# Alternativa: ruta a archivo JSON en el servidor
# GOOGLE_APPLICATION_CREDENTIALS=/home/.../sa.json
GOOGLE_SHEET_ID=1TWbOOjTnm68n2QioiwRsHvXSuARev2PLIhqr1pVctp8
METRICAS_SHEET_NAME=Metricas 2026 Auto
# Filtros de path (coma-separados)
# GA4_BLOG_PATH_CONTAINS=/blog
# GA4_COLECCIONES_PATH_CONTAINS=/coleccion,/collections,/catalogo,/tienda

# Meta (Instagram + Facebook Page) → Seguidores en Metricas
# En Hostinger el token se llama FB_META (también acepta META_PAGE_ACCESS_TOKEN)
FB_META=
# META_PAGE_ACCESS_TOKEN=
# META_PAGE_ID=
# META_IG_USER_ID=


